<UserControl x:Class="FpsLatencyPanel.App.Views.MouseKeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,32,36,40">
        <StackPanel>

            <!-- CABEÇALHO -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="MOUSE / TECLADO" Style="{StaticResource H1}"/>
                <TextBlock Text="Ajustes de input do Windows. Reversíveis a qualquer momento."
                           FontSize="14" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- AVISO RAW INPUT -->
            <Border Style="{StaticResource Card}" Padding="18"
                    Background="#1EF5B740" BorderBrush="#66F5B740">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Top" Margin="0,1,12,0"/>
                    <TextBlock Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                               FontSize="13" FontWeight="SemiBold"
                               Text="Jogos com RAW INPUT (WM_INPUT) ignoram as configurações de mouse do Windows. O ganho é real apenas em jogos/menus que usam WM_MOUSEMOVE."/>
                </StackPanel>
            </Border>

            <!-- LISTA DE AJUSTES -->
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Barra Lateral Colorida -->
                                <Border Grid.Column="0" Width="6" Height="40" CornerRadius="3"
                                        VerticalAlignment="Top"
                                        Background="{Binding State, Converter={StaticResource StateBrush}}"/>

                                <!-- Informações -->
                                <StackPanel Grid.Column="1" Margin="16,0,16,0">
                                    <TextBlock Text="{Binding Tweak.Name}"
                                               FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}"/>
                                    <TextBlock Text="{Binding Tweak.Description}"
                                               FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                               TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,12"/>
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Badge}"
                                                Background="{Binding State, Converter={StaticResource StateBrush}}">
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource BadgeText}"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource BorderLightBrush}">
                                            <TextBlock Text="{Binding Tweak.Impact, Converter={StaticResource ImpactText}}"
                                                       Style="{StaticResource BadgeText}" Foreground="{StaticResource TextBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource BorderLightBrush}">
                                            <TextBlock Text="{Binding Tweak.Risk, Converter={StaticResource RiskText}}"
                                                       Style="{StaticResource BadgeText}" Foreground="{StaticResource TextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Botões -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="APLICAR" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding DataContext.ApplyItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="REVERTER" Margin="8,0,0,0"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.RevertItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>