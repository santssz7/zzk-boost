<UserControl x:Class="FpsLatencyPanel.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,32,36,40">
        <StackPanel>

            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Backup" Style="{StaticResource H1}"/>
                <TextBlock Text="Reverter ajustes e inspecionar o log de operações."
                           FontSize="14" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <TextBlock Text="↩️  Reverter tudo" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                               Text="Desfaz TODOS os ajustes feitos pelo painel. Limpeza não é reversível (arquivos apagados não voltam). Reversão não exige reboot."/>
                    <Button Style="{StaticResource DangerButton}"
                            Content="Reverter todos os ajustes"
                            HorizontalAlignment="Left"
                            Command="{Binding RevertAllCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <TextBlock Text="📄  Log de operações" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding LogPath}" FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Atualizar" Command="{Binding RefreshCommand}"/>
                        <Button Content="Abrir pasta do log" Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding OpenLogFolderCommand}"/>
                    </StackPanel>

                    <Border Background="{StaticResource BgDeepBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                        <ListBox ItemsSource="{Binding Recent}" MaxHeight="420"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}">
                                                <Run Text="{Binding TimestampUtc, StringFormat=HH:mm:ss}"/>
                                                <Run Text="  ["/>
                                                <Run Text="{Binding Level}"/>
                                                <Run Text="]  "/>
                                                <Run Text="{Binding Source}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                       FontSize="13" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>