<UserControl x:Class="FpsLatencyPanel.App.Views.GamesPowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,32,36,40">
        <StackPanel>

            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="JOGOS / ENERGIA" Style="{StaticResource H1}"/>
                <TextBlock Text="Ajustes de desempenho e energia. Exigem atenção."
                           FontSize="14" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- DASHBOARD -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Medidor de Performance (Sem porcentagem e sem sombra) -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="⚡" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="STATUS DE PERFORMANCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Barra usando Colunas (Não trava o WPF) -->
                        <Grid Height="14" Margin="0,0,0,8">
                            <Border Background="{StaticResource BgBrush}" CornerRadius="7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="85*"/> <!-- Parte Preenchida -->
                                    <ColumnDefinition Width="15*"/> <!-- Parte Vazia -->
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="7,0,0,7"/>
                            </Grid>
                        </Grid>
                        
                        <Grid>
                            <TextBlock Text="MODO ECONÔMICO" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Text="ALTO DESEMPENHO" FontSize="10" Foreground="{StaticResource AccentTextBrush}" HorizontalAlignment="Right" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Content="▶ APLICAR SEGUROS"
                                Command="{Binding ApplyAllSafeCommand}"/>
                        <Button Content="↻ ATUALIZAR STATUS" Margin="0,10,0,0" Style="{StaticResource GhostButton}"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ALERTA DE REINÍCIO -->
            <Border Style="{StaticResource Card}" Padding="18"
                    Background="#1EFFB020" BorderBrush="#66FFB020"
                    Visibility="{Binding RebootNotice, Converter={StaticResource StringNotEmptyToVis}}"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding RebootNotice}"
                               Foreground="{StaticResource WarnBrush}"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock Text="AJUSTES DISPONÍVEIS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="4,10,0,12"/>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="6" Height="40" CornerRadius="3"
                                        VerticalAlignment="Top"
                                        Background="{Binding State, Converter={StaticResource StateBrush}}"/>

                                <StackPanel Grid.Column="1" Margin="16,0,16,0">
                                    <TextBlock Text="{Binding Tweak.Name}"
                                               FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource TitleFont}"/>
                                    <TextBlock Text="{Binding Tweak.Description}"
                                               FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                               TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,12"/>
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Badge}"
                                                Background="{Binding State, Converter={StaticResource StateBrush}}">
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource BadgeText}"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource BorderLightBrush}">
                                            <TextBlock Text="{Binding Tweak.Impact, Converter={StaticResource ImpactText}}"
                                                       Style="{StaticResource BadgeText}" Foreground="{StaticResource TextBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource BorderLightBrush}">
                                            <TextBlock Text="{Binding Tweak.Risk, Converter={StaticResource RiskText}}"
                                                       Style="{StaticResource BadgeText}" Foreground="{StaticResource TextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="APLICAR" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding DataContext.ApplyItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="REVERTER" Margin="8,0,0,0"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.RevertItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>