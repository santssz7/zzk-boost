<UserControl x:Class="FpsLatencyPanel.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FpsLatencyPanel.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,32,36,40">
        <StackPanel>

            <!-- CABEÇALHO -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="INÍCIO" Style="{StaticResource H1}"/>
                <TextBlock Text="Visão geral do seu sistema e ajustes rápidos."
                           FontSize="14" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- DASHBOARD GRID -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <!-- COLUNA ESQUERDA -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    
                    <!-- Card: Sistema -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14"
                                    Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" VerticalAlignment="Top">
                                <TextBlock Text="🖥️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                <TextBlock Text="SEU SISTEMA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding EnvSummary}" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card: Perfil -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF00E5FF" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                                    </Border.Effect>
                                    <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="PERFIL RECOMENDADO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentTextBrush}"/>
                                    <TextBlock Text="{Binding ProfileSummary}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Ajustes de risco baixo, reversíveis com 1 clique, com backup automático. Foco em reduzir latência de input e eliminar interferência em jogo."
                                       FontSize="13" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <CheckBox Content="Criar ponto de restauração antes (recomendado)" IsChecked="{Binding CreateRestorePoint}" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="▶  APLICAR PERFIL"
                                        Command="{Binding DataContext.ApplyRecommendedCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Button Content="Atualizar status" Margin="12,0,0,0" Style="{StaticResource GhostButton}"
                                        Command="{Binding DataContext.RefreshHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>

                            <ProgressBar Height="4" Margin="0,16,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding Progress}" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- COLUNA DIREITA: SCORE GAUGE -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="STATUS DE OTIMIZAÇÃO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        
                        <controls:CircularGauge Value="{Binding OtimizacaoPercent}" Width="220" Height="220" Margin="0,0,0,14"/>
                        
                        <TextBlock Text="{Binding AppliedCount}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Meta: 100% do perfil" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TÍTULO SEÇÃO AJUSTES -->
            <TextBlock Text="DETALHES DOS AJUSTES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="4,10,0,12"/>

            <!-- LISTA DE AJUSTES -->
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="6" Height="40" CornerRadius="3" VerticalAlignment="Top"
                                        Background="{Binding State, Converter={StaticResource StateBrush}}"/>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding Tweak.Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding Tweak.Description}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                               TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,12"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Badge}" Background="{Binding State, Converter={StaticResource StateBrush}}">
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource BadgeText}"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource BorderLightBrush}">
                                            <TextBlock Text="{Binding Tweak.Impact, Converter={StaticResource ImpactText}}" Style="{StaticResource BadgeText}" Foreground="{StaticResource TextBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource BorderLightBrush}">
                                            <TextBlock Text="{Binding Tweak.Risk, Converter={StaticResource RiskText}}" Style="{StaticResource BadgeText}" Foreground="{StaticResource TextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>