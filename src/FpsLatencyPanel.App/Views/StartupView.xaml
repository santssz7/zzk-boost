<UserControl x:Class="FpsLatencyPanel.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,32,36,40">
        <StackPanel>

            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Inicialização" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding Hint}" FontSize="14"
                           Foreground="{StaticResource TextDimBrush}"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Button Content="🔄  Atualizar lista" HorizontalAlignment="Left" Margin="0,0,0,16"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding RefreshCommand}"/>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Command}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextDimBrush}"
                                               Margin="0,6,0,4"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Location}"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Badge}" Margin="0,0,10,0"
                                            Background="{StaticResource BorderLightBrush}">
                                        <TextBlock Text="{Binding IsEnabled, Converter={StaticResource BoolToEnabledText}}"
                                                   Style="{StaticResource BadgeText}"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </Border>
                                    <Button Content="{Binding ToggleText}"
                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>