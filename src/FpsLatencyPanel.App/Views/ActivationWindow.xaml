<Window x:Class="FpsLatencyPanel.App.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZZK BOOST — Ativação"
        Width="540" Height="740"
        MinWidth="500" MinHeight="680"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}"
        StateChanged="Window_StateChanged">

    <Border x:Name="RootBorder" BorderThickness="1"
            BorderBrush="{StaticResource BorderLightBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="16"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF0B0F15" Offset="0"/>
                <GradientStop Color="#FF07090D" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ BARRA SUPERIOR ============ -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <TextBlock Text="Ativação" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">

                    <!-- MINIMIZAR -->
                    <Button x:Name="MinimizeButton" Content="─"
                            FontSize="14" FontWeight="Bold"
                            Width="44" Height="34"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextDimBrush}"
                            ToolTip="Minimizar"
                            Cursor="Hand"
                            Click="Minimize_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelHoverBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- MAXIMIZAR / RESTAURAR -->
                    <Button x:Name="MaximizeButton" Content="▢"
                            FontSize="13"
                            Width="44" Height="34" Margin="2,0,0,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextDimBrush}"
                            ToolTip="Maximizar"
                            Cursor="Hand"
                            Click="Maximize_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelHoverBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- FECHAR -->
                    <Button x:Name="CloseButton" Content="✕"
                            FontSize="13" FontWeight="Bold"
                            Width="44" Height="34" Margin="2,0,0,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextDimBrush}"
                            ToolTip="Fechar"
                            Cursor="Hand"
                            Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FFEF4A5A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ CONTEÚDO ============ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="36,4,36,28">
                <StackPanel>

                    <!-- Logo -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,4,0,26">
                        <Border Width="72" Height="72" CornerRadius="18"
                                Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF00D9FF" BlurRadius="32" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <TextBlock Text="⚡"
                                       FontSize="38"
                                       Foreground="#FF00131A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                       <TextBlock Text="ZZK BOOST" FontSize="24" FontWeight="Bold"
           HorizontalAlignment="Center" Margin="0,16,0,2"
           Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Ative sua licença para começar" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Card: Machine ID -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SEU MACHINE ID" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                            <Border Background="{StaticResource BgDeepBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding MachineId, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="14" Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Content="⧉"
                                            FontSize="15"
                                            Width="36" Height="32" Padding="0"
                                            Style="{StaticResource GhostButton}"
                                            Margin="10,0,0,0"
                                            ToolTip="Copiar"
                                            Click="CopyMachineId_Click"/>
                                </Grid>
                            </Border>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"
                                       Text="Envie este ID ao vendedor para receber sua licença."/>
                        </StackPanel>
                    </Border>

                    <!-- Card: Key -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SUA LICENÇA" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="KeyTextBox" Height="88"
         AcceptsReturn="True" TextWrapping="Wrap"
         VerticalScrollBarVisibility="Auto"
         FontFamily="{StaticResource MonoFont}" FontSize="11"
         VerticalContentAlignment="Top"/>

<StackPanel Orientation="Horizontal" Margin="0,14,0,0">
    <Button Content="📁  Carregar key.txt" 
            Style="{StaticResource GhostButton}"
            Click="LoadKeyFile_Click"/>
    <Button Content="✓  Ativar licença" Margin="10,0,0,0"
            Style="{StaticResource PrimaryButton}"
            Click="Activate_Click"/>
</StackPanel>
                            <TextBlock x:Name="StatusText" Margin="0,12,0,0"
                                       TextWrapping="Wrap" FontSize="12"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Ainda não tem licença -->
                    <Border Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,2,0,0">
                        <StackPanel>
                            <TextBlock Text="Ainda não tem licença?" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Text="Adquira uma licença para desbloquear todos os ajustes do painel."/>
                            <Button Content="Comprar licença" Margin="0,12,0,0"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Center"
                                    Click="Buy_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Footer -->
                    <TextBlock Text="Validação 100% offline. Nenhum dado é enviado pela internet."
                               FontSize="10" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,18,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>