<UserControl x:Class="FpsLatencyPanel.App.Controls.CircularGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Grid Width="100" Height="100">
            <!-- Círculo de fundo -->
            <Ellipse Stroke="{StaticResource BorderBrush}" StrokeThickness="8" Margin="6"/>
            
            <!-- Arco de progresso (Vai usar DashArray para ser perfeito) -->
            <Ellipse Name="ProgressCircle" Stroke="{StaticResource AccentBrush}" StrokeThickness="8" 
                     Margin="6" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-90"/> <!-- Começa no topo -->
                </Ellipse.RenderTransform>
            </Ellipse>
            
            <!-- Textos -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Name="PercentText" Text="0%" FontFamily="{StaticResource TitleFont}" 
                           FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                <TextBlock Text="OTIMIZADO" FontFamily="{StaticResource TitleFont}" 
                           FontSize="6" Foreground="{StaticResource TextDimBrush}" 
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>